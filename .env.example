# NewsAPI (https://newsapi.org) - free tier: 100 requests/day
NEWSAPI_KEY=

# Which LLM to use for the briefing: "anthropic" (default) or "groq"
LLM_PROVIDER=anthropic

# Anthropic API (https://console.anthropic.com) - used when LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# Optional: override the default model (claude-sonnet-5). E.g. claude-haiku-4-5 for lower cost.
ANTHROPIC_MODEL=

# Groq API (https://console.groq.com/keys) - used when LLM_PROVIDER=groq
GROQ_API_KEY=

# Telegram bot (create via @BotFather)
BOT_TOKEN=
# Your user id, or a channel handle like @my_channel
CHAT_ID=
